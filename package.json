{
  "name": "omp-designer",
  "version": "5.1.0",
  "type": "module",
  "description": "Focused UI/UX workflow for Pi and oh-my-pi with 4 conditional skills, evidence-aware checks, and browser-first review.",
  "keywords": [
    "pi-package",
    "pi",
    "design",
    "ui",
    "ux",
    "design-system",
    "animation",
    "frontend",
    "color-palette",
    "typography",
    "anti-slop"
  ],
  "author": "Leandro",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/LePro10/omp-designer.git"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://pi.dev/logo-auto.svg"
  },
  "omp": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "bin": {
    "omp-designer": "./scripts/lifecycle-cli.mjs"
  },
  "files": [
    "extension/",
    "extensions/",
    "skills/",
    "data/",
    "scripts/analyze-layout.mjs",
    "scripts/audit-data.mjs",
    "scripts/audit-trace.mjs",
    "scripts/check-release.mjs",
    "scripts/fix-ai-slop.mjs",
    "scripts/install-local.mjs",
    "scripts/lifecycle-cli.mjs",
    "scripts/lifecycle-lib.mjs",
    "scripts/real-agent-eval.mjs",
    "shared/",
    "scripts/uninstall-system.mjs",
    "docs/",
    "AGENTS.md",
    "architecture.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:extension": "bun test scripts/__tests__/extension.test.ts",
    "test:e2e": "bun test scripts/__tests__/host-bridge.test.ts",
    "test:validators": "node scripts/__tests__/fix-ai-slop.test.mjs",
    "test:layout": "node scripts/__tests__/analyze-layout.test.mjs",
    "test:lifecycle": "node scripts/__tests__/lifecycle.test.mjs",
    "test:data": "node scripts/audit-data.mjs",
    "test:trace": "node scripts/__tests__/audit-trace.test.mjs",
    "test:prompt": "node scripts/__tests__/prompt-contract.test.mjs",
    "test:docs": "node scripts/__tests__/docs-contract.test.mjs",
    "test:quality": "node scripts/__tests__/design-quality.test.mjs",
    "test:cleanup": "node scripts/__tests__/cleanup-artifacts.test.mjs",
    "cleanup:artifacts": "node scripts/cleanup-artifacts.mjs",
    "test:security": "node scripts/__tests__/security.test.mjs",
    "test": "npm run typecheck && npm run test:extension && npm run test:e2e && npm run test:validators && npm run test:layout && npm run test:lifecycle && npm run test:data && npm run test:trace && npm run test:prompt && npm run test:docs && npm run test:quality && npm run test:cleanup && npm run test:security",
    "e2e:smoke": "bun scripts/e2e-smoke.mjs",
    "test:real": "node scripts/real-agent-eval.mjs",
    "system:inspect": "node scripts/uninstall-system.mjs",
    "uninstall:system": "node scripts/uninstall-system.mjs",
    "uninstall:system:apply": "node scripts/uninstall-system.mjs --apply",
    "install:local": "node scripts/install-local.mjs",
    "install:local:apply": "node scripts/install-local.mjs --apply",
    "install:local:clean": "node scripts/install-local.mjs --apply --clean",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm test && npm run check:release"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
